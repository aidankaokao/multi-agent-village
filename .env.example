# ============================================================
# Multi-Agent Village 部署設定
# 複製成 .env 後修改：cp .env.example .env
# .env 已在 .gitignore 中，不會進 git
# ============================================================

# --- Compose 專案名稱（容器 / volume / network 的前綴）---
COMPOSE_PROJECT_NAME=multi-agent-village

# --- Image 名稱與版本 ---
# IMAGE_REGISTRY 留空 = 只在本機；推到 registry 時填前綴，例如 registry.example.com/village/
IMAGE_REGISTRY=
BACKEND_IMAGE=village-backend
FRONTEND_IMAGE=village-frontend
IMAGE_TAG=0.1.0

# --- Base image 版本（build 時使用）---
PYTHON_VERSION=3.12
UV_VERSION=0.6.14
NODE_VERSION=20
NGINX_VERSION=1.27

# --- 對外 port（只有前端對外，綁 0.0.0.0；後端不開 port，經前端 nginx 代理）---
# 必填：瀏覽器要連的 port，例如 8080 → http://localhost:8080
FRONTEND_PORT=

# --- 執行環境 ---
TZ=Asia/Taipei
# 容器內連主機上的 Ollama 用 host.docker.internal
VILLAGE_OLLAMA_URL=http://host.docker.internal:11434/v1

# --- 帳號 ---
# 第一次打開網頁時，第一個註冊的帳號就是管理員；之後的註冊是一般成員（管理員可在「帳號」頁關閉註冊）。
# 忘記密碼：docker-compose exec backend village reset-password <帳號>

# --- 主金鑰（建議留空，第一次啟動會自動產生並存在 village-secrets volume）---
# 主金鑰（base64 32 bytes）：只有要交給外部 secret 管理時才填。
# 一旦有加密資料後不可更換，否則已存的 API key 會解不開。
VILLAGE_MASTER_KEY=
