# ============================================================
# 文件彙整師（獨立 agent）部署設定
# 複製成 .env 後修改：cp .env.example .env（.env 不會進 git）
# ============================================================

COMPOSE_PROJECT_NAME=report-maker-agent
IMAGE_REGISTRY=
IMAGE_NAME=report-maker-agent
IMAGE_TAG=0.1.0
PYTHON_VERSION=3.12
UV_VERSION=0.6.14
TZ=Asia/Taipei

# --- 對外 port ---
# 測試網頁與 API：http://localhost:8101
RM_PORT=8101
# 預設只開給本機。要讓區網其他機器連，改成 0.0.0.0（但 LLM 的 key 與文件會以明碼在網路上傳，建議加 HTTPS）
RM_BIND=127.0.0.1
# 寫進 agent card 的網址（其他系統照這個呼叫）
RM_PUBLIC_URL=http://localhost:8101

# --- 存取 token（必填）---
# 呼叫 A2A 時要帶 Authorization: Bearer <token>；可以設多個（逗號分隔），例如給不同的呼叫端各一個。
# 留空時 ./build.sh 會自動產生一個填進來。沒有 token 時服務一律拒絕呼叫。
RM_ACCESS_TOKENS=

# --- 報告用的 LLM：由呼叫端每次帶進來，這裡不放任何 LLM 的 key ---
# 呼叫端可以指定的 LLM 主機（逗號分隔）；留空 = openrouter.ai、api.openai.com、localhost、127.0.0.1、host.docker.internal
RM_ALLOWED_LLM_HOSTS=

# --- 上傳限制 ---
RM_MAX_FILES=3
RM_MAX_FILE_MB=10
RM_MAX_TOTAL_MB=20
# 每個工作表 / CSV 最多讀幾列、PDF 最多讀幾頁
RM_MAX_ROWS=50000
RM_MAX_PAGES=100

# 每份文件交給 LLM 的字數上限（超過的先分段摘要）；本機小模型 context 小，可以調低到 4000
RM_DOC_CHARS=8000
# 同時產生幾份報告（其餘排隊）與容器記憶體上限
RM_MAX_CONCURRENT=2
RM_MEM_LIMIT=2g
