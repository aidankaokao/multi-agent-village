# ============================================================
# 網路研究員（獨立 agent）部署設定
# 複製成 .env 後修改：cp .env.example .env（.env 不會進 git）
# ============================================================

COMPOSE_PROJECT_NAME=web-researcher-agent
IMAGE_REGISTRY=
IMAGE_NAME=web-researcher-agent
IMAGE_TAG=0.1.0
PYTHON_VERSION=3.12
UV_VERSION=0.6.14
TZ=Asia/Taipei

# --- 對外 port ---
# 測試網頁與 API：http://localhost:8102
WR_PORT=8102
# 預設只開給本機。要讓區網其他機器連，改成 0.0.0.0（但 LLM 的 key 會以明碼在網路上傳，建議加 HTTPS）
WR_BIND=127.0.0.1
# 寫進 agent card 的網址（其他系統照這個呼叫）
WR_PUBLIC_URL=http://localhost:8102

# --- 存取 token（必填）---
# 呼叫 /ask、/search、A2A 時要帶 Authorization: Bearer <token>；可以設多個（逗號分隔）。
# 留空時 ./build.sh 會自動產生一個填進來。沒有 token 時服務一律拒絕呼叫。
WR_ACCESS_TOKENS=

# --- 搜尋引擎（SearXNG，和研究員一起跑、不對外開放）---
# SearXNG 的金鑰：留空時 ./build.sh 會自動產生
SEARXNG_SECRET=
# 搜尋語言
WR_LANGUAGE=zh-TW

# --- 回答用的 LLM：由呼叫端每次帶進來，這裡不放任何 LLM 的 key ---
# 呼叫端可以指定的 LLM 主機（逗號分隔）；留空 = openrouter.ai、api.openai.com、localhost、127.0.0.1、host.docker.internal
WR_ALLOWED_LLM_HOSTS=

# --- 研究的份量 ---
# 一個問題改寫成幾組關鍵字、最多讀幾個網頁、交給 LLM 幾段資料（本機 Ollama 的上下文小，可以把段落調低到 6）
WR_MAX_QUERIES=3
WR_MAX_PAGES=6
WR_PASSAGES=10
