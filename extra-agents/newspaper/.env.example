# ============================================================
# 報社（獨立 agent）部署設定
# 複製成 .env 後修改：cp .env.example .env（.env 不會進 git）
# ============================================================

COMPOSE_PROJECT_NAME=newspaper-agent
IMAGE_REGISTRY=
IMAGE_NAME=newspaper-agent
IMAGE_TAG=0.1.0
PYTHON_VERSION=3.12
UV_VERSION=0.6.14
TZ=Asia/Taipei

# --- 對外 port ---
# 測試網頁與 API：http://localhost:8103
NP_PORT=8103
# 預設只開給本機。要讓區網其他機器連，改成 0.0.0.0（但 LLM 的 key 會以明碼在網路上傳，建議加 HTTPS）
NP_BIND=127.0.0.1
# 寫進 agent card 的網址（其他系統照這個呼叫）
NP_PUBLIC_URL=http://localhost:8103

# --- 存取 token（必填）---
# 呼叫 A2A 時要帶 Authorization: Bearer <token>；可以設多個（逗號分隔）。
# 留空時 ./build.sh 會自動產生一個填進來。沒有 token 時服務一律拒絕呼叫。
NP_ACCESS_TOKENS=

# --- 寫稿用的 LLM：由呼叫端每次帶進來，這裡不放任何 LLM 的 key ---
# 呼叫端可以指定的 LLM 主機（逗號分隔）；留空 = openrouter.ai、api.openai.com、localhost、127.0.0.1、host.docker.internal
NP_ALLOWED_LLM_HOSTS=

# --- 報紙 ---
# 報頭（報紙名稱）
NP_MASTHEAD=村莊日報

# --- 採訪資料限制 ---
NP_MAX_FILES=6
NP_MAX_FILE_MB=2
NP_MAX_TOTAL_MB=6
# 每份資料交給 LLM 的字數上限；本機小模型 context 小，可以調低到 3000
NP_DOC_CHARS=6000
# 同時編幾份報紙（其餘排隊）與容器記憶體上限
NP_MAX_CONCURRENT=2
NP_MEM_LIMIT=1g
