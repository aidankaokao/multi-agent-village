# ============================================================
# 台灣史專家（獨立 agent）部署設定
# 複製成 .env 後修改：cp .env.example .env（.env 不會進 git）
# ============================================================

COMPOSE_PROJECT_NAME=taiwan-history-agent
IMAGE_REGISTRY=
IMAGE_NAME=taiwan-history-agent
IMAGE_TAG=0.1.0
PYTHON_VERSION=3.12
UV_VERSION=0.6.14
TZ=Asia/Taipei

# --- 對外 port ---
# 網頁與 API：http://localhost:8100
TH_PORT=8100
# 預設只開給本機。要讓區網其他機器連，改成 0.0.0.0（但 LLM 的 key 會以明碼在網路上傳，建議加 HTTPS）
TH_BIND=127.0.0.1
# 寫進 agent card 的網址（其他系統照這個呼叫）
TH_PUBLIC_URL=http://localhost:8100

# --- 存取 token（必填）---
# 呼叫 /ask、/search、A2A 時要帶 Authorization: Bearer <token>；可以設多個（逗號分隔），例如給不同的呼叫端各一個。
# 留空時 ./build.sh 會自動產生一個填進來。沒有 token 時服務一律拒絕呼叫。
TH_ACCESS_TOKENS=

# --- embedding（固定用本地 Ollama 的 bge-m3；資料與問題必須用同一個模型）---
# 主機要先執行：ollama pull bge-m3
TH_OLLAMA_URL=http://host.docker.internal:11434
TH_EMBED_MODEL=bge-m3

# --- 回答用的 LLM：由呼叫端每次帶進來，這裡不放任何 LLM 的 key ---
# 呼叫端可以指定的 LLM 主機（逗號分隔）；留空 = openrouter.ai、api.openai.com、localhost、127.0.0.1、host.docker.internal
TH_ALLOWED_LLM_HOSTS=

# 每次檢索取幾段資料給 LLM
TH_TOP_K=8
